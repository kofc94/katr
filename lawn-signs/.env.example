# Build-time configuration for the lawn sign tracker.
#
# Every value here is a PUBLIC identifier and is safe to ship in the JS bundle.
# Never add an AWS access key or secret to this file — the app authenticates
# with Cognito and calls the API with the resulting JWT. There is no code path
# that accepts a static AWS credential.
#
# Copy to `.env.local` and fill in from the stack outputs:
#
#   cd ../platform && tofu output
#
# Leave these unset to run entirely on local demo data with no AWS account.

VITE_API_ENDPOINT=          # tofu output lawn_signs_api_endpoint
VITE_COGNITO_USER_POOL_ID=  # tofu output lawn_signs_user_pool_id
VITE_COGNITO_CLIENT_ID=     # tofu output lawn_signs_user_pool_client_id
VITE_COGNITO_DOMAIN=        # tofu output lawn_signs_cognito_domain
VITE_EVENT_ID=katr-2026
